            "value" : "Bu hesaplar keşfedilmek istemiyor olabilir veya koleksiyonları desteklemeyen bir sunucuda yer alıyor olabilirler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ці облікові записи, можливо, відмовилися від участі у процесі виявлення даних або знаходяться на сервері, який не підтримує колекції."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những tài khoản này không muốn khám phá, hoặc họ ở trên máy chủ chưa hỗ trợ gói khởi đầu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These accounts may have opted out of discovery, or they might be on a server that doesn’t support collections."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些帳號可能選擇退出探索功能，或他們所在之伺服器未支援收藏名單。"
          }
        }
      }
    },
