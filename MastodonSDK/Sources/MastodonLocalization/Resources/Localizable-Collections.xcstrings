        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med samlinger (kommer i Mastodon 4.6) kan du oprette dine egne kuraterede lister over konti, som du kan anbefale til andre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Sammlungen (ab Mastodon v4.6) kannst du eigene Listen kuratieren, um auf empfehlenswerte Profile hinzuweisen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι Συλλογές (που έρχονται στο Mastodon 4.6) επιτρέπουν να δημιουργήσεις τις δικές σου επιμελημένες λίστες λογαριασμών για να συστήσεις σε άλλους."
          }
        },
        "en" : {
          "stringUnit" : {
