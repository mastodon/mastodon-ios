    "Scene.Collections.collectionsExplainerLong" : {
      "extractionState" : "manual",
      "localizations" : {
        "an" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Collections (coming in Mastodon 4.6) allow you to create your own curated lists of accounts to recommend to others."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتيح لك مزيّة المجموعات (التي ستتوفر في ماستودون ٤٫٦) إنشاء قوائمك الخاصة من الحسابات التي يمكنك التوصية بها للآخرين."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калекцыі (новая функцыя Mastodon 4.6) дазволяць Вам ствараць свае ўласныя спісы ўліковых запісаў, каб раіць іх іншым."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Collections (coming in Mastodon 4.6) allow you to create your own curated lists of accounts to recommend to others."
          }
