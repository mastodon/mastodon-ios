    "Scene.Donation.Success.ServerErrorMessage" : {
      "extractionState" : "migrated",
      "localizations" : {
        "an" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "We are sorry, an error occurred and we have not been able to process your donation.\n\nPlease retry in a few minutes."
