          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn không thể xem trang người này\ncho tới khi họ bỏ chặn bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您不能查看此用户的个人资料\n直到他解除屏蔽。"
