          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je nám líto, došlo k chybě a nepodařilo se nám zpracovat váš příspěvek.\n\nZkuste to prosím znovu za pár minut."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "We are sorry, an error occurred and we have not been able to process your donation.\n\nPlease retry in a few minutes."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi beklager, men der opstod en fejl, og vi har ikke været i stand til at behandle din donation.\n\nForsøg venligst igen om et par minutter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir bitten um Verzeihung, ein Fehler trat auf und wir konnten deine Spende nicht verarbeiten.\n\nBitte versuche es in ein paar Minuten nochmal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λυπούμαστε, πρόεκυψε ένα σφάλμα και δεν καταφέραμε να διεκπαιρεώσουμε την δωρέα σου.\n\nΔοκίμασε ξανά σε λίγα λεπτά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
