    "Scene.ServerPicker.EmptyState.BadNetwork" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدث خطأٌ ما أثناء تحميل البيانات. تحقَّق من اتصالك بالإنترنت."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нешта пайшло не так падчас загрузкі даных. Праверце інтэрнэт-злучэнне."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguna cosa no ha anat bé en carregar les dades. Comprova la teva connexió a Internet."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هەڵەیەک ڕوویدا لە کاتی بارکردن. لە هەبوونی هێڵی ئینتەرنێت دڵنیا بە."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při načítání dat nastala chyba. Zkontrolujte připojení k internetu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Laden der Daten ist etwas schief gelaufen. Überprüfe deine Internetverbindung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάτι πήγε στραβά κατά τη φόρτωση των δεδομένων. Έλεγξε τη σύνδεσή σου στο διαδίκτυο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Something went wrong while loading the data. Check your internet connection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo ha ido mal al cargar los datos. Comprueba tu conexión a Internet."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arazoren bat egon da datuak kargatzean. Egiaztatu zure Interneteko konexioa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokin meni pieleen dataa ladatessa. Tarkista internet-yhteytesi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une erreur s'est produite lors du chargement des données. Vérifiez votre connexion Internet."
          }
        },
        "gd" : {
          "stringUnit" : {
            "state" : "translated",
