          "stringUnit": {
            "state": "needs_review",
            "value": "Þú getur ekki séð snið þessa notanda\nfyrr en þú hættir að útiloka hann.\nSniðið þitt lítur svona út hjá honum."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anda tidak dapat melihat profil pengguna ini sampai Anda membuka blokir mereka.\nProfil Anda terlihat seperti ini bagi mereka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non puoi visualizzare il profilo di questo utente\nfinché non li sblocchi.\nIl tuo profilo sembra questo per loro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ブロックを解除するまでこのユーザーをみることはできません。\nそういうことです。"
          }
        },
        "kab": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ur tezmireḍ ara ad twaliḍ amaɣnu n useqdac-a\nalamma tekkseḍ-as asewḥel.\nAkka i as-d-yettban umaɣnu-inek."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "You can’t view this user's profile\nuntil you unblock them.\nYour profile looks like this to them."
          }
        },
        "kmr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nikarî profîla vî/ê bikarhênerî bibînî\nHeya ku tu astengiyê li ser wî/ê ranekî.\nProfîla te ji wan ra wiha xuya dike."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tu nevari skatīt šī lietotāja profilu,\nlīdz tu tos atbloķē.\nTavs profils viņiem izskatās šādi."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "You can’t view this user's profile\nuntil you unblock them.\nYour profile looks like this to them."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie możesz wyświetlić profilu tego użytkownika\ndopóki nie odblokujesz go.\nTwój profil wygląda tak dla nich."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não podes ver o perfil deste utilizador\nenquanto estiveres a bloqueá-lo.\nPara ele, o teu perfil tem este aspeto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você não pode ver o perfil deste usuário até desbloqueá-lo.\nSeu perfil aparece assim para esse usuário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "You can’t view this user's profile\nuntil you unblock them.\nYour profile looks like this to them."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вы не можете просматривать\nпрофиль этого пользователя\nпока не разблокируете его.\n\nПримерно так выглядит\nваш профиль для него."
          }
        },
        "gd": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chan fhaic thu pròifil a’ chleachdaiche seo\n gus an dì-bhac thu iad.\nSeo an coltas a th’ air a’ phròifil agad dhaibh-san."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "You can’t view this user's profile\nuntil you unblock them.\nYour profile looks like this to them."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profila tega uporabnika ne morete\nvideti, dokler jih ne odblokirate.\nVaš profil je zanje videti tako."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ناتوانیت پرۆفایلی ئەم بەکارهێنەرە ببینیت\nهەتا ئاستەنگەکەیان لادەبەیت.\nپرۆفایلەکەت ئاوها لایان دەردەکەوێت."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No puedes ver el perfil de este usuario\n hasta que lo desbloquees.\nTu perfil se ve así para él."
          }
        },
        "es-AR": {
          "stringUnit": {
            "state": "translated",
            "value": "No podés ver el perfil de este usuario\nhasta que lo desbloquees.\nTu perfil le aparece así a este usuario."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du kan inte visa användarens profil\nförrän du avblockerar dem.\nDin profil ser ut så här för dem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คุณไม่สามารถดูโปรไฟล์ของผู้ใช้นี้\nจนกว่าคุณจะเลิกปิดกั้นเขา\nโปรไฟล์ของคุณมีลักษณะเช่นนี้สำหรับเขา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu kişinin engelini kaldırana kadar\nonun profilini göremezsiniz.\nBu kişiye göre profiliniz böyle gözüküyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ви не можете переглянути профіль цього користувача, поки ви не розблокуєте їх.\nВаш профіль виглядає так."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bạn không thể xem trang người này\ncho tới khi bạn bỏ chặn họ.\nHọ sẽ thấy trang của bạn như thế này."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ni allwch gweld proffil y ddefnyddiwr hwn\nos ydych wedi'u blocio.\nMae'ch proffil chi yn edrych fel hyn iddynt."
          }
        }
      }
    },
