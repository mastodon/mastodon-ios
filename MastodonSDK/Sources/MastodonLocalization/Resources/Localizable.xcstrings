    "Common.Controls.Timeline.Header.BlockedWarning" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يُمكِنُكَ عَرض الملف التَعريفي لهذا المُستخدِم\nحتَّى يَرفَعَ الحَظرَ عَنك."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы не можаце праглядаць профіль гэтага карыстальніка, \nпакуль ён не разблакіруе вас."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pots veure el perfil d'aquest usuari\nfins que et desbloqui."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ناتوانیت پرۆفایلی ئەم بەکارهێنەرە ببینیت\nتا ئەو کاتەی ئاستەنگەکەت لادەبات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemůžeš zobrazit profil tohoto uživatele, dokud tě neodblokují."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Profil dieses Benutzers\nkann nicht angezeigt werden, bis er dich entsperrt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν μπορείς να δεις το προφίλ αυτού του χρήστη\nμέχρι να σε ξεμπλοκάρει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can’t view this user’s profile\nuntil they unblock you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No puedes ver el perfil de este usuario\nhasta que te desbloquee."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezin duzu erabiltzaile honen profila ikusi\ndesblokeatzen zaituen arte."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et voi tarkastella tämän tilin profiilia\nennen kuin hän poistaa eston."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne pouvez pas voir le profil de cet utilisateur\n tant qu'il ne vous aura pas débloqué."
          }
        },
        "gd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chan fhaic thu pròifil a’ chleachdaiche seo\n mus dì-bhac iad thu."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non podes ver o perfil desta usuaria\nata que te desbloquee."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can’t view this user’s profile\nuntil they unblock you."
          }
        },
        "hy-AM" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can’t view this user’s profile\nuntil they unblock you."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non puoi visualizzare il profilo di questo utente\nfino a quando non ti sbloccano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブロックされているようです..."
          }
        },
        "kab" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ur tezmireḍ ara ad twaliḍ amaɣnu n useqdac-a\nAkka i as-d-yettban umaɣnu-inek."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu nikarî profîla vî/ê bikarhênerî bibînî\nheya ku ew astengiyê li ser te rakin."
          }
        },
        "ku-TR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu nikarî profîla vî/ê bikarhênerî bibînî\nheya ku ew astengiyê li ser te rakin."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt het profiel van deze gebruiker niet bekijken zolang je geblokkeerd bent."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы не можете просматривать\nпрофиль этого пользователя\nпока он не разблокирует вас."
          }
        },
        "sl" : {
          "stringUnit" : {
