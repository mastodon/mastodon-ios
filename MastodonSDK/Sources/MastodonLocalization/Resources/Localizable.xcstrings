    },
    "Common.Controls.Timeline.Header.BlockingWarning" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يُمكِنُكَ الاِطلاع على الملف التَعريفي لهذا المُستخدِم\nحتَّى تَرفعَ الحَظر عنه.\nملفُّكَ التَعريفي يَظهَرُ بِمثل هذِهِ الحالة بالنسبةِ لَهُ أيضًا."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы не можаце праглядаць профіль гэтага карыстальніка, \nпакуль не разблакіруеце яго.\nВось так для іх выглядае ваш профіль."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pots veure el perfil d'aquest usuari\nfins que el desbloquis.\nEl teu perfil els sembla així."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ناتوانیت پرۆفایلی ئەم بەکارهێنەرە ببینیت\nهەتا ئاستەنگەکەیان لادەبەیت.\nپرۆفایلەکەت ئاوها لایان دەردەکەوێت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemůžete zobrazit profil tohoto uživatele, dokud ho neodblokujete.\nVáš profil pro něj vypadá takto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst das Profil dieses Benutzers nicht sehen\n solange du den Benutzer nicht entsperrst.\nDein Profil sieht für diesen Benutzer auch so aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν μπορείς να δεις το προφίλ αυτού του χρήστη\nμέχρι να τον ξεμπλοκάρεις.\nΤο προφίλ σου μοιάζει έτσι και σε αυτόν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can’t view this user's profile\nuntil you unblock them.\nYour profile looks like this to them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No puedes ver el perfil de este usuario\n hasta que lo desbloquees.\nTu perfil se ve así para él."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezin duzu erabiltzaile honen profila ikusi\ndesblokeatzen duzun arte.\nZure profilak itxura hau du berarentzat."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et voi tarkastella tämän tilin profiilia\nennen kuin poistat sen esto.\nProfiilisi näyttää tältä hänelle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne pouvez pas voir le profil de cet utilisateur\n tant que vous ne l’avez pas débloqué\nVotre profil ressemble à ça pour lui."
          }
        },
        "gd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chan fhaic thu pròifil a’ chleachdaiche seo\n gus an dì-bhac thu iad.\nSeo an coltas a th’ air a’ phròifil agad dhaibh-san."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non podes ver o perfil da usuaria\nata que a desbloquees.\nAsí ven outras o teu perfil."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can’t view this user's profile\nuntil you unblock them.\nYour profile looks like this to them."
          }
        },
        "hy-AM" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can’t view this user's profile\nuntil you unblock them.\nYour profile looks like this to them."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non puoi visualizzare il profilo di questo utente\nfinché non li sblocchi.\nIl tuo profilo sembra questo per loro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブロックを解除するまでこのユーザーをみることはできません。\nそういうことです。"
          }
        },
        "kab" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ur tezmireḍ ara ad twaliḍ amaɣnu n useqdac-a\nalamma tekkseḍ-as asewḥel.\nAkka i as-d-yettban umaɣnu-inek."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu nikarî profîla vî/ê bikarhênerî bibînî\nHeya ku tu astengiyê li ser wî/ê ranekî.\nProfîla te ji wan ra wiha xuya dike."
          }
        },
        "ku-TR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu nikarî profîla vî/ê bikarhênerî bibînî\nHeya ku tu astengiyê li ser wî/ê ranekî.\nProfîla te ji wan ra wiha xuya dike."
          }
        },
        "nl" : {
