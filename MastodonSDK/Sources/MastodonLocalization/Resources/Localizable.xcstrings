    "Scene.ConfirmEmail.DontReceiveEmail.Description" : {
      "extractionState" : "migrated",
      "localizations" : {
        "an" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compreba que la tuya adreza de correu electronico sía correcta y revisa la carpeta de correu no deseyau si no l'has feito ya."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقق ممَّ إذا كان عنوان بريدك الإلكتروني صحيحًا، وكذلك تأكد مِن مجلد البريد غير الهام إذا لم تكن قد فعلت ذلك."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Праверце, ці правільны ваш адрас электроннай пошты, а таксама папку са спамам, калі вы гэтага яшчэ не зрабілі."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprova que la teva adreça de correu electrònic és correcte i revisa la carpeta de correu brossa si encara no ho has fet."
          }
        },
        "ckb-IR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دڵنیا بە لەوەی ئیمێڵەکەت دروستە و هەموو بوخچەکانت بگەڕێ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkontrolujte, zda je vaše e-mailová adresa správná, stejně jako složka nevyžádané pošty, pokud ji máte."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gwiriwch a yw eich cyfeiriad e-bost yn gywir a hefyd eich ffolder 'junk' os nad ydych wedi ei gwneud."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjek, om din e-mailadresse er korrekt, og tjek din spam-mappe, hvis du ikke har gjort det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überprüfe, ob deine E-Mail-Adresse korrekt ist und sieh im Spam-Ordner nach, falls du es noch nicht getan hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έλεγξε αν η διεύθυνση email σου είναι σωστή καθώς και τον φάκελο ανεπιθύμητης αλληλογραφίας σας αν δεν το έχεις κάνει ήδη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check if your email address is correct as well as your junk folder if you haven’t."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Check if your email address is correct as well as your junk folder if you haven’t."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba que tu dirección de correo electrónico sea correcta y revisa la carpeta de correo no deseado si no lo has hecho ya."
          }
        },
        "es-AR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisá si tu dirección de correo electrónico es correcta así como tu carpeta de correo basura / correo no deseado / spam, si todavía no lo hiciste."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palun kontrolli, kas sinu e-posti aadress on õige ja igaks juhuks vaata ka rämsposti kausta."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egiaztatu zure eposta helbidea zuzena den eta begiratu zaborraren karpeta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkista, että sähköpostiosoitteesi on oikea, sekä roskapostikansiosi, jos et vielä ole."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez que votre adresse courriel est valide ainsi que votre fichier spam si ce n’est pas déjà fait."
          }
        },
        "gd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dearbh gu bheil an seòladh puist-d agad mar bu chòir agus nach eil dad ann am pasgan an truilleis."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comproba que o enderezo de email é correcto e que non vaia directo ao cartafol de spam."
