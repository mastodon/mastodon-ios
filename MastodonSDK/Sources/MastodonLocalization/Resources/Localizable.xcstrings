        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีโพสต์อื่นใดที่คุณต้องการเพิ่มไปยังรายงานหรือไม่?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu rapora eklemek istediğiniz başka gönderiler var mı?"
