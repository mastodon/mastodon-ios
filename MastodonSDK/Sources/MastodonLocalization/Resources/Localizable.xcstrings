    "Common.Controls.Status.Visibility.Direct" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المُستخدمِونَ المُشارِ إليهم فَقَطْ مَن يُمكِنُهُم رُؤيَةُ هَذَا المَنشُور."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Толькі згаданы карыстальнік можа бачыць гэты пост."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només l'usuari mencionat pot veure aquest tut."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تەنیا بەکارهێنەرە ئاماژە پێکراوەکە دەتوانێت ئەم پۆستە ببینێت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pouze zmíněný uživatel může vidět tento příspěvek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur erwähnte Benutzer können diesen Beitrag sehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόνο ο αναφερόμενος χρήστης μπορεί να δει αυτή την ανάρτηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Only mentioned user can see this post."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo el usuario mencionado puede ver este mensaje."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aipatutako erabiltzaileek soilik ikus dezakete bidalketa hau."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain mainittu käyttäjä voi nähdä julkaisun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul·e l’utilisateur·rice mentionnée peut voir ce message."
          }
        },
        "gd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chan fhaic ach an cleachdaiche air an dugadh iomradh am post seo."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só a usuaria mencionada pode ver a publicación."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only mentioned user can see this post."
          }
        },
        "hy-AM" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only mentioned user can see this post."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo l'utente menzionato può vedere questo post."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この投稿はメンションされたユーザーに限り見ることができます。"
          }
        },
        "kab" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D ineḍfaren-is kan i izemren ad walin tsuffeɣ-a."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenê bikarhênerê qalkirî dikare vê şandiyê bibîne."
          }
        },
        "ku-TR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenê bikarhênerê qalkirî dikare vê şandiyê bibîne."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen de vermelde persoon kan dit bericht zien."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только указанный пользователь может видеть это сообщение."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samo omenjeni uporabnik lahko vidi to objavo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endast omnämnda användare kan se detta inlägg."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เฉพาะผู้ใช้ที่กล่าวถึงเท่านั้นที่สามารถเห็นโพสต์นี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sadece bahsedilen kullanıcı bu gönderiyi görebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ người được nhắc đến có thể thấy tút."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有被提及的用户才能看到此嘟文。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有被提及的使用者能看到此嘟文。"
          }
        }
      }
    },
