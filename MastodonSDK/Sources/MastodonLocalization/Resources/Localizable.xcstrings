    "Scene.Welcome.Education.Mastodon.Description" : {
      "extractionState" : "migrated",
      "localizations" : {
        "an" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mastodon is a decentralized social network, meaning no single company controls it. It’s made up of many independently-run servers, all connected together."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ماستدون شبكة اجتماعية لامركزية، بمعنى أنه ليس هناك شركة واحدة تتحكم فيها. وهي تتألف من العديد من الخوادم التي تدار بشكل مستقل، وجميعها متصلة معا."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon - гэта дэцэнтралізаваная сацыяльная сетка, што азначае, што ні адна кампанія не кантралюе яе. Ён складаецца з мноства незалежна працуюць сервераў, злучаных разам."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon és un xarxa social descentralitzada, el que significa que cap empresa la controla. Es composa de molts servidors administrats independentment, tots interconnectats."
          }
        },
        "ckb-IR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mastodon is a decentralized social network, meaning no single company controls it. It’s made up of many independently-run servers, all connected together."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon je decentralizovaná sociální síť, což znamená, že ji neovládá žádná jednotlivá společnost. Skládá se z mnoha nezávisle spravovaných serverů, všechny jsou propojeny dohromady."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae Mastodon yn rhwydwaith cymdeithasol datganoledig, sy'n golygu nad oes un cwmni yn ei reoli. Mae'n cynnwys llawer o weinyddion annibynnol, gyda phob un wedi'u cysylltu gyda'i gilydd."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon er et decentraliseret socialt netværk, hvilket betyder, at ingen enkelt virksomhed kontrollerer det. Det består af mange uafhængigt drevne servere, som alle er forbundet med hinanden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon ist ein dezentrales, soziales Netzwerk. Das bedeutet, dass es nicht von einem einzigen Unternehmen kontrolliert wird. Das Netzwerk besteht aus unabhängig voneinander betriebenen Servern, die miteinander verbunden sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Mastodon είναι ένα αποκεντρωμένο κοινωνικό δίκτυο που σημαίνει ότι καμία εταιρεία δεν το ελέγχει. Αποτελείται από πολλούς ανεξάρτητους διακομιστές, όλοι συνδεδεμένοι μαζί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon is a decentralized social network, meaning no single company controls it. It’s made up of many independently-run servers, all connected together."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mastodon is a decentralized social network, meaning no single company controls it. It’s made up of many independently-run servers, all connected together."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon es una red social descentralizada, lo que significa que no la controla una sola compañía. Está formada por muchos servidores independientes, todos juntos conectados."
          }
        },
        "es-AR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon es una red social descentralizada, lo que significa que no la controla una sola compañía. Está conformada por varios servidores administrados independientemente, conectados entre sí."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon on hajutatud sotsiaalvõrgustik, mis tähendab, et seda ei kontrolli üks ja ainus organisatsioon või äriühing. Võrgustikus tegutsevad omavahel ühendatud paljud erinevad koduserverid."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon sare sozial deszentralizatua da, eta horrek esan nahi du ez duela konpainia bakar batek kontrolatzen. Zerbitzari independente askok osatzen dute, denak batera konektatuta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon on hajautettu sosiaalinen verkosto, joka tarkoittaa sitä, ettei sitä hallitse mikään yksittäinen yritys. Se koostuu monista itsenäisesti ylläpidetyistä palvelimista, jotka on liitetty yhteen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon est un réseau social décentralisé, ce qui signifie qu’aucune entreprise ne le contrôle. Il est composé de plusieurs serveurs indépendants, tous connectés ensembles."
          }
        },
        "gd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "’S e lìonra sòisealta sgaoilte a th’ ann am Mastodon agus is ciall dha seo nach eil e fo smachd aon chompanaidh a-mhàin. Tha e dèanta de ghrunn fhrithealaichean a tha ’gan ruith gu neo-eisimeileach ach ceangailte ri chèile."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon é unha rede social descentralizada, onde ningunha empresa ten o control. Está formada por moitos servidores independentes comunicándose entre si."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mastodon is a decentralized social network, meaning no single company controls it. It’s made up of many independently-run servers, all connected together."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mastodon is a decentralized social network, meaning no single company controls it. It’s made up of many independently-run servers, all connected together."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Mastodon egy decentralizált közösségi hálózat, ami azt jelenti, hogy nem egyetlen vállalat irányítja. Sok, egymástól függetlenül működtetett kiszolgálóból áll, amelyek össze vannak egymással kötve."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mastodon is a decentralized social network, meaning no single company controls it. It’s made up of many independently-run servers, all connected together."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mastodon is a decentralized social network, meaning no single company controls it. It’s made up of many independently-run servers, all connected together."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon er dreyfhýst samfélagsnet, sem þýðir að ekkert eitt fyrirtæki ræður yfir því. Netið samanstendur af mörgum sjálfstætt reknum netþjónum sem tengjast innbyrðis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon è un social network decentralizzato, il che significa che nessuna singola azienda lo controlla. È composto da molti server indipendenti che comunicano tra loro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon は、いち企業の統制に依存しない非中央集権型のソーシャルネットワークです。たくさんの独立したサーバーが相互につながり合い、ひとつのネットワークを形成しています。"
          }
        },
        "kab" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mastodon is a decentralized social network, meaning no single company controls it. It’s made up of many independently-run servers, all connected together."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon은 분산형 소셜 네트워크로, 어떤 단일 회사도 이를 통제하지 않으며, 모두 서로 연결된 여러 개의 독립적으로 운영되는 서버로 구성되어 있습니다."
          }
        },
        "ku-TR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon tora civakî ya nenavendî ye, tê vê wateyê ku wê ti şîrket wê kontrol nake. Ew ji gelek rajekarên serbixwe-têne birêvebirin pêk tê, hemû bi hev ve girêdayî ne."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Mastodon“ – tai decentralizuotas socialinis tinklas ir tai reiškia, kad jo nevaldo nė viena įmonė. Jį sudaro daugybė nepriklausomai veikiančių serverių, sujungtų tarpusavyje."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mastodon is a decentralized social network, meaning no single company controls it. It’s made up of many independently-run servers, all connected together."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mastodon is a decentralized social network, meaning no single company controls it. It’s made up of many independently-run servers, all connected together."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon is een gedecentraliseerd sociaal netwerk, wat betekent dat geen enkel bedrijf het controleert. Het bestaat uit veel onafhankelijk opererende servers, allemaal verbonden met elkaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon to zdecentralizowana sieć społecznościowa, co oznacza że żadna firma nie może nią kontrolować w całości. Składa się z wielu niezależnych od siebie serwerów, które się ze sobą komunikują."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mastodon é uma rede social descentralizada, ou seja, nenhuma empresa a controla. Ela é composta por muitos servidores independentes que comunicam entre si."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon é uma rede social descentralizada, o que significa que nenhuma empresa a controla. É composto por muitos servidores administrados de forma independente, todos conectados entre si."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mastodon is a decentralized social network, meaning no single company controls it. It’s made up of many independently-run servers, all connected together."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon - это децентрализованная социальная сеть, то есть ее не контролирует ни одна компания. Она состоит из множества независимо управляемых серверов, соединенных вместе."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mastodon is a decentralized social network, meaning no single company controls it. It’s made up of many independently-run servers, all connected together."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon je decentralizirano družbeno omrežje, kar pomeni, da ga ne upravlja nobeno posamezno podjetje. Sestavljajo ga številni neodvisni strežniki, ki so medsebojno povezani."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon är ett decentraliserat socialt nätverk, vilket innebär att inget enskilt företag kontrollerar det. Det består av många oberoende servrar, alla sammankopplade."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon เป็นเครือข่ายสังคมแบบกระจายศูนย์ หมายความว่าไม่มีบริษัทใดควบคุมเครือข่ายสังคม เครือข่ายสังคมประกอบด้วยเซิร์ฟเวอร์ที่ทำงานอย่างอิสระจำนวนมาก ทั้งหมดเชื่อมต่อเข้าด้วยกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon merkeziyetçi olmayan bir sosyal ağdır, yani tek bir şirketin kontrolünde değildir. Hepsi birbirine bağlı olarak çalışan, birçok bağımsız sunucudan oluşur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon - це децентралізована соціальна мережа, тобто жодна компанія не контролює її. У її склад входить велика кількість незалежних серверів пов'язаних між собою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon là một mạng xã hội phi tập trung, không có công ty nào kiểm soát. Nó bao gồm nhiều máy chủ độc lập được kết nối với nhau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon 是去中心化的社交网络，这意味着它不由任何企业独控，而是由众多独立运行的实例联结而成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mastodon 是去中心化的社交網路，意思是沒有單一公司掌控它。它由許多獨立運行而互相連接的伺服器組成。"
          }
        }
      }
    },
