        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We’ll pick a server based on your language if you continue without making a selection."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chúng tôi sẽ chọn một máy chủ dựa trên ngôn ngữ của bạn nếu bạn tiếp tục mà không lựa chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您不想选择，我们将会根据您的语言挑选一个实例。"
