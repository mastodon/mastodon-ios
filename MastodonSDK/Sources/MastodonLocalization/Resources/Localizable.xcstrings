            "value" : "Žal ne najdemo objav s ključnikom <a>#%@</a>. Poskusite z <a>#drugimKljučnikom</a> ali preverite nastavitve gradnika."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ledsen, vi kunde inte hitta några inlägg med hashtaggen <a>#%@</a>. Prova en <a>#AnnanHashtagg</a> eller kontrollera widgetinställningarna."
