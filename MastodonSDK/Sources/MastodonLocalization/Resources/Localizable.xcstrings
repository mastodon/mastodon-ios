    "Scene.Report.StepFinal.TheyWillNoLongerBeAbleToFollowOrSeeYourPostsButTheyCanSeeIfTheyveBeenBlocked": {
      "comment": null,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They will no longer be able to follow or see your posts, but they can see if they’ve been blocked."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لَن يَتمكَّنَ بَعدَ الآنِ مِن مُتابَعَةِ مَنشوراتِكَ أو رُؤيَتِها، وَلكِن يُمكِنَهُ مَعرِفَةُ مَا إذا حُظَرِت عَنه."
          }
        },
        "an": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ya no podrán estar capaces de seguir-te u veyer las tuyas publicacions, pero pueden veyer si han estau blocaus."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "needs_review",
            "value": "They will no longer be able to follow or see your posts, but they can see if they’ve been blocked."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ezin izango dituzte zure bidalketak jarraitu edo ikusi, baina blokeatuta dauden ikusi ahal izango dute."
          }
        },
        "be": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Яны больш не змогуць падпісвацца на вас або бачыць вашыя допісы, але змогуць бачыць, што яны былі заблакіраваны."
          }
        },
        "my": {
          "stringUnit": {
            "state": "needs_review",
            "value": "They will no longer be able to follow or see your posts, but they can see if they’ve been blocked."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ja no podran seguir ni veure els teus tuts, però poden veure si han estat blocats."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "他们将不再能够关注或看到您的嘟文，但他们可以知道他们是否被屏蔽。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "他們將無法跟隨您或是看到您的嘟文。他們能看到他們是否已被封鎖。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Už nebudou moci sledovat nebo vidět vaše příspěvky, ale mohou vidět, zda byly zablokovány."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De vil ikke længere kunne følge eller se dine indlæg, men de kan se, om de er blevet blokeret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Het is niet meer mogelijk om je te volgen of om je berichten te zien, maar ze kunnen wel zien dat ze geblokkeerd zijn."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "needs_review",
            "value": "They will no longer be able to follow or see your posts, but they can see if they’ve been blocked."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ta enam ei saa sind jälgid ega sinu postitusi lugeda ning tal on väimalik teada kaaada, kas ta on blokeeritud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "He eivät enää voi seurata tai nähdä julkaisujasi, eivätkä myöskään tiedä sinun estäneen heidät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ils ne seront plus en mesure de suivre ou de voir vos messages, mais iels peuvent voir s’iels ont été bloqué·e·s."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non poderá seguirte nin ver o que publicas, pero pode ver se foi bloqueada."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du wirst die Beiträge von diesem Konto nicht sehen. Das Konto wird nicht in der Lage sein, deine Beiträge zu sehen oder dir zu folgen. Die Person hinter dem Konto wird wissen, dass du das Konto blockiert hast."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Δε θα μπορούν πλέον να σε ακολουθούν ή να βλέπουν τις αναρτήσεις σου, αλλά μπορούν να δουν αν έχουν αποκλειστεί."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "They will no longer be able to follow or see your posts, but they can see if they’ve been blocked."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "They will no longer be able to follow or see your posts, but they can see if they’ve been blocked."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "They will no longer be able to follow or see your posts, but they can see if they’ve been blocked."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viðkomandi mun ekki lengur geta fylgst með eða séð færslurnar þínar, en munu sjá ef viðkomandi hefur verið útilokaður."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "They will no longer be able to follow or see your posts, but they can see if they’ve been blocked."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non saranno più in grado di seguire o vedere i tuoi post, ma possono vedere se sono stati bloccati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "相手はあなたの投稿を見たり、フォローしたりできなくなります。あなたにブロックされていることはわかります。"
          }
        },
        "kab": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ur ttuɣalen ara ad izmiren ad ak•akem-ḍefren neɣ ad walin tisuffaɣ-inek•inem, maca ad walin ma yella ttusweḥlen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "그는 나를 팔로우 하거나 내 게시물을 볼 수 없게 됩니다, 하지만 내가 차단한 사실은 알 수 있습니다."
          }
        },
        "kmr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Êdî nikarin şandiyên te bişopînin an jî bibînin, lê ew dikarin bibînin ka hatine astengkirin an na."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Viņi vairs nevarēs sekot tavām ziņām vai redzēt tās, taču varēs redzēt, vai viņi ir bloķēti."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "They will no longer be able to follow or see your posts, but they can see if they’ve been blocked."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "They will no longer be able to follow or see your posts, but they can see if they’ve been blocked."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eles não poderão seguir-te ou ver as tuas publicações, mas conseguem ver se foram bloqueados por ti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Essa conta não poderá mais te seguir ou ver suas postagens, mas ela poderá ver que foi bloqueada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "They will no longer be able to follow or see your posts, but they can see if they’ve been blocked."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Этот пользователь больше не сможет подписаться на вас или читать ваши посты. Он(а) сможет видеть, что заблокирован(а)."
          }
        },
        "gd": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chan urrainn dhaibh ’gad leantainn is chan fhaic iad na postaichean agad tuilleadh ach chì iad gun deach am bacadh."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
