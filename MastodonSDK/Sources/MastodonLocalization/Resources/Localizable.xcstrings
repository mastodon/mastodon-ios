    "Scene.ConfirmEmail.OpenEmailApp.Description": {
      "comment": null,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We just sent you an email. Check your junk folder if you haven’t."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لقد أرسلنا لك بريدًا إلكترونيًا للتو. تحقق من مجلد البريد غير الهام الخاص بك إذا لم تكن قد فعلت ذلك."
          }
        },
        "an": {
          "stringUnit": {
            "state": "needs_review",
            "value": "T'acabamos de ninviar un correu electronico. Revisa la tuya carpeta de correu no deseyau si no l'has feito ya."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "needs_review",
            "value": "We just sent you an email. Check your junk folder if you haven’t."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eposta bat bidali dizugu. Egiaztatu zure zaborraren karpeta."
          }
        },
        "be": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Мы толькі што даслалі вам электронны ліст. Праверце папку са спамам, калі не знайшлі яго."
          }
        },
        "my": {
          "stringUnit": {
            "state": "needs_review",
            "value": "We just sent you an email. Check your junk folder if you haven’t."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Acabem d'enviar-te un correu electrònic. Revisa la carpeta de correu brossa si encara no ho has fet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "我们刚刚向您发送了一封电子邮件。如果没有收到，请检查您的垃圾邮件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "我們剛寄送您一封電子郵件。請檢查您的垃圾信件夾。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Právě jsme vám poslali e-mail. Zkontrolujte složku nevyžádané zprávy, pokud ji máte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vi har lige sendt dig en e-mail. Tjek din spam-mappe, hvis du ikke har gjort det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "We hebben je een e-mail gestuurd. Controleer ook je spamfolder."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "needs_review",
            "value": "We just sent you an email. Check your junk folder if you haven’t."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Me just saatsime sulle e-kirja. Kui sa pole seda saanud, siis vaata igaks juhuks ka spämmikausta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lähetimme sinulle juuri sähköpostin. Tarkista myös roskapostikansiosi, jos et vielä ole."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nous venons de vous envoyer un courriel. Vérifier votre fichier spam si vous ne l’avez pas déjà fait."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enviámosche un email. Se non aparece, mira no cartafol do lixo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wir haben dir gerade eine E-Mail geschickt. Überprüfe deinen Spam-Ordner, falls du es noch nicht getan hast."
          }
        },
        "el": {
          "stringUnit": {
