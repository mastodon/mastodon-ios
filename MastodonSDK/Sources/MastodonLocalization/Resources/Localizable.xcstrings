          }
        },
        "eu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ezin izan dugu <a>#%@</a> traola duen bidalketarik aurkitu. Saiatu <a>#BesteTraolaBatekin</a> edo egiaztatu widgetaren ezarpenak."
          }
        },
        "be": {
          "stringUnit": {
            "state": "needs_review",
            "value": "На жаль, мы не змаглі знайсці допісы з хэштэгам <a>#%@</a>. Калі ласка, паспрабуйце <a>#ІншыХэштэг</a> або праверце налады віджэта."
          }
        },
        "my": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sorry, we couldn’t find any posts with the hashtag <a>#%@</a>. Please try a <a>#DifferentHashtag</a> or check the widget settings."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ho sentim, no hem pogut trobar cap tut amb l'etiqueta <a>#%@</a>. Si us plau, prova una <a>#EtiquetaDiferent</a> o revisa la configuració del giny."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "抱歉，我们找不到任何带有<a>#%@</a>话题的嘟文。请尝试一个<a>#不同的话题</a>或检查小组件设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "很抱歉，無法找到任何帶有 <a>#%@</a> 主題標籤之嘟文。請嘗試 <a>#另一個主題標籤</a> 或檢查小工具設定。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Omlouváme se, nepodařilo se nám najít žádné příspěvky s hashtag <a>#%@</a>. Zkuste prosím <a>#DifferentHashtag</a> nebo zkontrolujte nastavení widgetu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beklager, vi kunne ikke finde nogen indlæg med hashtagget <a>#%@</a>. Prøv et <a>#DifferentHashtag</a> eller tjek widget-indstillingerne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sorry, maar we konden geen berichten met de hashtag <a>#%@</a> vinden. Probeer een <a>#AndereHashtag</a> of controleer de widgetinstellingen."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sorry, we couldn’t find any posts with the hashtag <a>#%@</a>. Please try a <a>#DifferentHashtag</a> or check the widget settings."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vabandust, me ei leidnud ühtegi postitust teemaviitega <a>#%@</a>. Palun proovi <a>#MuudTeemaviidet</a> või kontrollin vidina seadistusi."
          }
