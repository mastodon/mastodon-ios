        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquests son els tuts que criden l'atenció en el teu racó de Mastodon."
          }
        },
        "ckb-IR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پۆست هەیە سەرنجیان لەسەرە لە گۆشەکەی تۆ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto jsou příspěvky, které získávají pozornost ve vašem koutu Mastodonu."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dyma'r postiadau sy'n denu tipyn o sylw yn eich cŵr Mastodon."
