        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo sentimos, se ha producido un error y no hemos podido procesar tu donación.\n\nVuelve a intentarlo dentro de unos minutos."
          }
        },
        "es-AR" : {
          "stringUnit" : {
