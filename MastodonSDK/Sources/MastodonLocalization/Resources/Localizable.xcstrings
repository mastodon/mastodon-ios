        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aktuální vybraný profil: %@. Dvojitým poklepáním zobrazíte přepínač účtů"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aktuell ausgewähltes Profil: %@. Doppeltippen dann gedrückt halten, um den Kontoschalter anzuzeigen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Τρέχον επιλεγμένο προφίλ: %@. Πάτα δύο φορές και κράτησε πατημένο για να εμφανίσεις την εναλλαγή λογαριασμού"
