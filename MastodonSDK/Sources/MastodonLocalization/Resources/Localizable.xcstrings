        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這是帶有 <a>#hashtag</a> 主題標籤之嘟文的樣子。請於小工具設定中挑選任何 <a>#hashtag</a> 主題標籤。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Takto by vypadal příspěvek s <a>#hashtag</a>. Vyberte si jakýkoliv <a>#hashtag</a> který chcete v nastavení widgetu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sådan ser et indlæg med et <a>#hashtag</a> ud. Vælg det <a>#hashtag</a>, du vil have, i widget-indstillingerne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zo ziet een bericht met een <a>#hashtag</a> eruit. Kies de door jou gewenste <a>#hashtag</a> in de widgetinstellingen."
