          }
        },
        "hy": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Expands the GIF. Double-tap and hold to show actions"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "GIFa hedatzen du. Egin tap birritan eta mantendu ekintzak erakusteko"
          }
        },
        "be": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Разгортванне GIF. Двойчы націсніце і ўтрымлівайце, каб паказаць дзеянні"
          }
        },
        "my": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Expands the GIF. Double-tap and hold to show actions"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Expandeix el GIF. Toca dues vegades i manté pressionat per a mostrar les opcions"
