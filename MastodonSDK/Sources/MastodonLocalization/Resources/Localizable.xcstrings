    "Scene.ServerRules.Prompt.%@" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في حال إختيارك للمواصلة، أنت تخضع لشروط الخدمة وسياسة الخصوصية لِـ%@."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Працягваючы, вы згаджаецеся з умовамі выкарыстання і палітыкай канфідэнцыяльнасці %@."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al continuar, estàs subjecte als termes de servei i a la política de privacitat de %@."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بەردەوامبوونت واتای ڕازیبوونتە بە مەرجەکانی خزمەتگوزاری و سیاسەتی تایبەتێتیی %@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokračováním budete podléhat podmínkám služby a zásad ochrany osobních údajů pro uživatele %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du fortfährst, unterliegst du den Nutzungsbedingungen und den Datenschutzrichtlinien für %@."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνεχίζοντας, υπόκεισαι στους όρους της υπηρεσίας και της πολιτικής απορρήτου για %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "By continuing, you’re subject to the terms of service and privacy policy for %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si continúas estarás sujeto a los términos de servicio y la política de privacidad de %@."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jarraituz gero, %@ instantziaren zerbitzu-baldintzak eta pribatutasun-gidalerroak onartzen dituzu."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jatkamalla, hyväksyt palvelun %@ palveluehdot ja tietosuojakäytönnön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En continuant, vous êtes assujettis à l’entente de service et la politique de confidentialité de %@."
          }
        },
        "gd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ma leanas tu air adhart, bidh thu fo bhuaidh teirmichean seirbheise is poileasaidh prìobhaideachd %@."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao continuar, acatas os termos do servizo e a política de privacidade para %@."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By continuing, you’re subject to the terms of service and privacy policy for %@."
          }
        },
        "hy-AM" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By continuing, you’re subject to the terms of service and privacy policy for %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuando, sei soggetto alle condizioni di servizio e all'informativa sulla privacy per %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同意することでお客様は以下のサービスの利用規約とプライバシーポリシーに従うことになります。 %@."
          }
        },
        "kab" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi ara tkemmleḍ, ilaq ad tqebleḍ tiwtilin n yimeẓla d tsertit tabaḍnit n %@."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bi domandinê, tu ji bo %@ di bin mercên bikaranînê û polîtîkaya nepenîtiyê dipejirînî."
          }
        },
        "ku-TR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bi domandinê, tu ji bo %@ di bin mercên bikaranînê û polîtîkaya nepenîtiyê dipejirînî."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je verder gaat ga je akkoord met de gebruiksvoorwaarden en privacybeleid van %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продолжая, вы соглашаетесь с условиям использования и политикой конфиденциальности %@."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če boste nadaljevali, za vas veljajo pogoji storitve in pravilnik o zasebnosti za %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genom att fortsätta omfattas du av villkoren för tjänsten och sekretesspolicyn för %@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การดำเนินการต่อแสดงว่าคุณอยู่ภายใต้เงื่อนไขการให้บริการและนโยบายความเป็นส่วนตัวสำหรับ %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devam ederek, %@ için kullanım şartlarını ve gizlilik politikasını kabul etmiş olursunuz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiếp tục nghĩa là bạn đồng ý điều khoản dịch vụ và chính sách bảo mật của %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果继续，您必须遵守 %@ 的服务条款和隐私政策。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果繼續，代表您將遵守 %@ 的服務條款與隱私權政策。"
          }
        }
      }
    },
