    "Scene.Report.StepFinal.YouWontSeeTheirPostsOrReblogsInYourHomeFeedTheyWontKnowTheyVeBeenMuted" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You won’t see their posts or boosts in your home feed. They won’t know they’ve been muted."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы не ўбачыце іх допісы або пашырэнні ў сваёй хатняй стужцы. Яны не даведаюцца, што вы іх ігнаруеце."
          }
        },
        "ca" : {
