    "Widget.Hashtag.NotFound.Content.%@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sorry, we couldn’t find any posts with the hashtag <a>#%@</a>. Please try a <a>#DifferentHashtag</a> or check the widget settings."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "На жаль, мы не змаглі знайсці допісы з хэштэгам <a>#%@</a>. Калі ласка, паспрабуйце <a>#ІншыХэштэг</a> або праверце налады віджэта."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ho sentim, no hem pogut trobar cap tut amb l'etiqueta <a>#%@</a>. Si us plau, prova una <a>#EtiquetaDiferent</a> o revisa la configuració del giny."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sorry, we couldn’t find any posts with the hashtag <a>#%@</a>. Please try a <a>#DifferentHashtag</a> or check the widget settings."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Omlouváme se, nepodařilo se nám najít žádné příspěvky s hashtag <a>#%@</a>. Zkuste prosím <a>#DifferentHashtag</a> nebo zkontrolujte nastavení widgetu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entschuldigung, wir konnten keine Beiträge mit dem Hashtag <a>#%@</a>finden. Bitte versuchen Sie einen <a>#DifferentHashtag</a> oder überprüfen Sie die Widget-Einstellungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Λυπούμαστε, δεν μπορέσαμε να βρούμε αναρτήσεις με την ετικέτα <a>#%@</a>. Παρακαλώ δοκίμασε ένα <a>#DifferentHashtag</a> ή έλεγξε τις ρυθμίσεις widget."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorry, we couldn’t find any posts with the hashtag <a>#%@</a>. Please try a <a>#DifferentHashtag</a> or check the widget settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lo sentimos, no hemos podido encontrar ninguna publicación con la etiqueta <a>#%@</a>. Por favor, prueba una <a>#EtiquetaDiferente</a> o comprueba la configuración del Widget."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ezin izan dugu <a>#%@</a> traola duen bidalketarik aurkitu. Saiatu <a>#BesteTraolaBatekin</a> edo egiaztatu widgetaren ezarpenak."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Valitettavasti emme löytäneet yhtään julkaisua aihetunnisteella <a>#%@</a>. Kokeile <a>#DifferentHashtag</a> tai tarkista widgetin asetukset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Désolé, nous n'avons trouvé aucun message avec le hashtag <a>#%@</a>. Veuillez essayer un <a>#DifferentHashtag</a> ou vérifier les paramètres du widget."
          }
        },
        "gd" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tha sinn duilich ach cha do lorg sinn post sa bheil an taga hais <a>#%@</a>. Feuch <a>#TagaHaisEile</a> no thoir sùil air roghainnean a’ widget."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lamentámolo, pero non atopamos nada co cancelo <a>#%@</a>. Inténtado cun <a>#CanceloDistinto</a> ou comproba os axustes."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sorry, we couldn’t find any posts with the hashtag <a>#%@</a>. Please try a <a>#DifferentHashtag</a> or check the widget settings."
          }
