        },
        "eu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ez dituzu bere bidalketa eta bultzadak hasierako jarioan ikusiko. Ez dute jakingo isilarazi dituztenik."
          }
        },
        "be": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вы не ўбачыце іх допісы або пашырэнні ў сваёй хатняй стужцы. Яны не даведаюцца, што вы іх ігнаруеце."
          }
        },
        "my": {
          "stringUnit": {
            "state": "needs_review",
            "value": "You won’t see their posts or boosts in your home feed. They won’t know they’ve been muted."
