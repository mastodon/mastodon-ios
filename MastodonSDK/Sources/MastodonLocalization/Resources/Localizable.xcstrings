    "Scene.Report.StepFinal.WhenYouSeeSomethingYouDontLikeOnMastodonYouCanRemoveThePersonFromYourExperience.": {
      "comment": null,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you see something you don’t like on Mastodon, you can remove the person from your experience."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عِندما تَرى شيئًا لَا يُعجِبُكَ عَلَى مَاستودُون، يُمكِنُكَ إزالَةُ الشَّخصِ مِن تَجرِبَتِك."
          }
        },
        "an": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quan veigas bella cosa que no te fa goyo en Mastodon, puetz sacar a la persona d'a tuya experiencia."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "needs_review",
            "value": "When you see something you don’t like on Mastodon, you can remove the person from your experience."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mastodonen gustuko ez duzun zerbait ikusten duzunean, zure esperientziatik atera dezakezu pertsona hori."
          }
        },
        "be": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Калі вы бачыце на Mastodon нешта, што вам не падабаецца, вы можаце выдаліць чалавека са свайго асяроддзя."
          }
        },
        "my": {
          "stringUnit": {
            "state": "needs_review",
            "value": "When you see something you don’t like on Mastodon, you can remove the person from your experience."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quan veus alguna cosa que no t'agrada a Mastodon, pots eliminar la persona de la teva experiència."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "当您在 Mastodon 看到令人反感的东西时，可以尝试移除它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "當您看到某些不喜歡的內容時，您可以將該帳號自您的體驗中移除。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Když uvidíte něco, co se vám nelíbí na Mastodonu, můžete odstranit tuto osobu ze svého zážitku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Når du ser noget, du ikke kan lide på Mastodon, kan du fjerne personen fra din tidslinje."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Als je iets ziet dat je niet leuk vindt op Mastodon, dan kun je die persoon op meerdere manieren verwijderen van je tijdlijn."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "needs_review",
            "value": "When you see something you don’t like on Mastodon, you can remove the person from your experience."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kui näed midagi, mis sulle Mastodonis ei meeldi, siis saad selle autori oma infovoost välistada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kun näet Mastodonissa jotain sellaista, josta et pidä, voit sulkea käyttäjän käyttökokemuksesi ulkopuolelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quand vous voyez quelque chose que vous n’aimez pas sur Mastodon, vous pouvez retirer la personne de votre expérience."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cando ves en Mastodon algo que non che gusta podes retirar a esa persoa da túa experiencia como usuaria."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn du etwas auf Mastodon siehst, das dir nicht gefällt, kannst du die Person aus deinem Umfeld entfernen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Όταν βλέπεις κάτι που δε σου αρέσει στο Mastodon, μπορείς να αφαιρέσεις το άτομο από την εμπειρία σου."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "When you see something you don’t like on Mastodon, you can remove the person from your experience."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "When you see something you don’t like on Mastodon, you can remove the person from your experience."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "When you see something you don’t like on Mastodon, you can remove the person from your experience."
          }
        },
        "is": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Þegar þú sér eitthvað á Mastodon sem þér líkar ekki, þá geturðu fjarlægt viðkomandi eintakling úr umhverfinu þínu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "When you see something you don’t like on Mastodon, you can remove the person from your experience."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quando vedi qualcosa che non ti piace su Mastodon, puoi rimuovere la persona dalla tua esperienza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mastodonで気に入らないものを見た場合、その人をあなたの体験から取り除くことができます。"
          }
        },
        "kab": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mi ara twaliḍ kra ur ak•am-neɛǧib ara ɣef Mastodon, tzemreḍ ad tekkseḍ amdan-nni seg tirmit-ik•im."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "마스토돈에서 보기 싫은 것을 보았다면, 해당하는 사람을 지울 수 있습니다."
          }
        },
        "kmr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dema li ser Mastodonê tiştekî ku tu jê hez nakî bibînî, tu dikarî ew kes ji navrûya xwe derxî."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kad pakalpojumā Mastodon redzi kaut ko, kas tev nepatīk, tu vari noņemt šo personu no savas pieredzes."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kai „Mastodon“ platformoje pamatote kažką, kas jums nepatinka, galite pašalinti žmogų iš savo patirties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "When you see something you don’t like on Mastodon, you can remove the person from your experience."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quando vês algo que não gostas no Mastodon podes remover a pessoa da tua experiência."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quando você vê algo que não gosta no Mastodon, você pode remover essa pessoa da sua experiência."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "When you see something you don’t like on Mastodon, you can remove the person from your experience."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Если кто-то в Mastodon публикует то, что вам не нравится, вы можете скрыть его."
          }
        },
        "gd": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nuair a chì thu rudeigin nach toigh leat air Mastodon, ’s urrainn dhut an neach a chumail fad air falbh uat."
          }
        },
        "si": {
          "stringUnit": {
            "state": "needs_review",
            "value": "When you see something you don’t like on Mastodon, you can remove the person from your experience."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Če vidite nekaj, česar na Masodonu ne želite, lahko odstranite osebo iz svoje izkušnje."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "When you see something you don’t like on Mastodon, you can remove the person from your experience."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cuando veas algo que no te gusta en Mastodon, puedes eliminar a la persona de tu experiencia."
          }
        },
        "es-AR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando veas algo que no te gusta en Mastodon, podés quitar a esa cuenta de tu experiencia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "När du ser något som du inte gillar på Mastodon kan du ta bort personen från din upplevelse."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เมื่อคุณเห็นบางอย่างที่คุณไม่ชอบใน Mastodon คุณสามารถเอาบุคคลออกจากประสบการณ์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mastodon'da beğenmediğiniz bir şey gördüğünüzde, o kişiyi deneyiminizden çıkarabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Якщо бачите щось, що вам не подобається в Mastodon, то можна вилучити людину зі свого оточення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Khi bạn thấy có gì đó mà bạn không thích trên Mastodon, bạn có thể tự loại bỏ chúng."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pan welwch chi gynnwys nad ydych chi'n ei hoffi ar Mastodon, gallwch dynnu'r person o'ch profiad."
          }
        }
      }
    },
