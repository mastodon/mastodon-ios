    "Scene.Discovery.Intro" : {
      "extractionState" : "migrated",
      "localizations" : {
        "an" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas son las publicacions que son ganando tracción en a tuya rincón de Mastodon."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هَذِهِ هِيَ المَنشُوراتُ الَّتي تَكْتَسِبُ شَعبِيَّةً فِي الرُّكنِ الخاصِّ بِكَ مِن مَاستُودون."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Допісы, што набіраюць папулярнасць у вашым кутку Mastodon."
