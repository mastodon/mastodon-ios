    "Common.Controls.Status.Media.ExpandGifHint": {
      "comment": null,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expands the GIF. Double-tap and hold to show actions"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Expands the GIF. Double-tap and hold to show actions"
          }
        },
        "an": {
