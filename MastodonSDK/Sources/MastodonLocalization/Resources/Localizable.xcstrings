        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fordítás nem sikerült. Lehet, hogy a rendszergazda nem engedélyezte a fordításokat ezen a kiszolgálón, vagy a kiszolgálón a Mastodon egy régebbi verziója fut, ahol a fordítások még nem támogatottak."
