    "Common.Alerts.SignOut.Message": {
      "comment": null,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to sign out?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هل أنت متأكد من رغبتك في تسجيل الخُروج؟"
          }
        },
        "an": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yes seguro de que quiers zarrar la sesión?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Համոզո՞ւած ես, որ ուզում ես դուրս գալ"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ziur saioa amaitu nahi duzula?"
          }
        },
        "be": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вы ўпэўненыя, што хочаце выйсці?"
