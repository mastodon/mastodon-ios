          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem tekintheti meg a felhasználó profilját,\namíg fel nem oldja az ön blokkolását."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You can’t view this user’s profile\nuntil they unblock you."
          }
