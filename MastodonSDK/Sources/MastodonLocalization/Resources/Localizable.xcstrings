    "Widget.Hashtag.Placeholder.Content" : {
      "extractionState" : "migrated",
      "localizations" : {
        "an" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is how a post with a <a>#hashtag</a> would look. Pick whichever <a>#hashtag</a> you want in the widget settings."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is how a post with a <a>#hashtag</a> would look. Pick whichever <a>#hashtag</a> you want in the widget settings."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вось як будзе выглядаць допіс з <a>#хэштэгам</a>. Выберыце любы <a>#хэштэг</a> у наладах віджэта."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Així és com es veuría un tut amb <a>#etiqueta</a>. Tria la <a>#etiqueta</a> que vulguis en la configuració del giny."
          }
        },
        "ckb-IR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is how a post with a <a>#hashtag</a> would look. Pick whichever <a>#hashtag</a> you want in the widget settings."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takto by vypadal příspěvek s <a>#hashtag</a>. Vyberte si jakýkoliv <a>#hashtag</a> který chcete v nastavení widgetu."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dyma sut y byddai post gyda <a>#hashnod</a> yn edrych. Dewiswch unrhyw <a>#hashnod</a> rydych chi ei eisiau gweld yng ngosodiadau'r widget."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sådan ser et indlæg med et <a>#hashtag</a> ud. Vælg det <a>#hashtag</a>, du vil have, i widget-indstillingerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So würde ein Beitrag mit einem <a>#Hashtag</a> aussehen. Wähle in den Widget-Einstellungen den gewünschten <a>#Hashtag</a> aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έτσι θα φαινόταν μια ανάρτηση με <a>#hashtag</a>. Επίλεξε όποιο <a>#hashtag</a> θες στις ρυθμίσεις widget."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is how a post with a <a>#hashtag</a> would look. Pick whichever <a>#hashtag</a> you want in the widget settings."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is how a post with a <a>#hashtag</a> would look. Pick whichever <a>#hashtag</a> you want in the widget settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Así es como una publicación con una <a>#etiqueta</a> se vería. Elige cualquier <a>#etiqueta</a> que desee en la configuración del widget."
          }
        },
        "es-AR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Así es cómo se vería un mensaje con una <a>#etiqueta</a>. Elegí una <a>#etiqueta</a> que quieras en la configuración del widget."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nii näeb välaj postitus <a>#teemaviitega</a>. Vidinate seadistustes saad valida mis tahes <a>#teemaviite</a>."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Horrela ikusiko litzateke <a>#traola</a> bat duen bidalketa bat. Aukeratu nahi duzun <a>#traola</a> widgetaren ezarpenetan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tältä aihetunnisteen <a>#aihetunniste</a> julkaisu näyttäisi. Valitse mikä tahansa <a>#aihetunniste</a> widgetin asetuksista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voici à quoi ressemblerait un message avec un <a>#hashtag</a>. Choisissez le <a>#hashtag</a> que vous voulez dans les paramètres du widget."
          }
        },
        "gd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seo an coltas a bhiodh air post le <a>#TagaHais</a>. Tagh <a>#TagaHais</a> sam bith a thogras tu ann an roghainnean a’ widget."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este é o aspecto dunha publicación cun <a>#cancelo</a>. Elixe o <a>#cancelo</a> que queres nos axustes do widget. "
