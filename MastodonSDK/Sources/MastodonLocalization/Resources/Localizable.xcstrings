        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "You won’t see their posts or boosts in your home feed. They won’t know they’ve been muted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "您不会在主页里看到他们的嘟文与转发。他们不会知道不会收到提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "您不會於您的首頁時間軸中再見到他們的嘟文或轉嘟。他們不會知道他們已被靜音。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neuvidíte jejich příspěvky nebo boosty ve svém domovském kanálu. Nebudou vědět, že jsou skryti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du vil ikke se deres opslag eller fremhævelser i dit hjem-feed. De vil ikke få at vide, at de er blevet skjult."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Je ziet hun berichten en boosts niet op je starttijdlijn. Ze zullen niet weten dat ze worden genegeerd."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "needs_review",
