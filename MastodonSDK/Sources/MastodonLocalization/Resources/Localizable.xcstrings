    "Scene.Privacy.Description": {
      "comment": null,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Although the Mastodon app does not collect any data, the server you sign up through may have a different policy.\n\nIf you disagree with the policy for **%@**, you can go back and pick a different server."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Although the Mastodon app does not collect any data, the server you sign up through may have a different policy.\n\nIf you disagree with the policy for **%@**, you can go back and pick a different server."
          }
        },
        "an": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Although the Mastodon app does not collect any data, the server you sign up through may have a different policy.\n\nIf you disagree with the policy for **%@**, you can go back and pick a different server."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Although the Mastodon app does not collect any data, the server you sign up through may have a different policy.\n\nIf you disagree with the policy for **%@**, you can go back and pick a different server."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Although the Mastodon app does not collect any data, the server you sign up through may have a different policy.\n\nIf you disagree with the policy for **%@**, you can go back and pick a different server."
          }
        },
        "be": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Нягледзячы на ​​тое, што праграма Mastodon не збірае даных, сервер, на якім вы рэгіструецеся, можа мець іншую палітыку.\n\nКалі вы адмовіцеся ад палітыкі **%@**, вы можаце вярнуцца і выбраць іншы сервер."
          }
        },
        "my": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Although the Mastodon app does not collect any data, the server you sign up through may have a different policy.\n\nIf you disagree with the policy for **%@**, you can go back and pick a different server."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Although the Mastodon app does not collect any data, the server you sign up through may have a different policy.\n\nIf you disagree with the policy for **%@**, you can go back and pick a different server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Although the Mastodon app does not collect any data, the server you sign up through may have a different policy.\n\nIf you disagree with the policy for **%@**, you can go back and pick a different server."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "即使 Mastodon app 本身不會蒐集任何資料，您所註冊之伺服器可能有不一樣的隱私權政策。\n\n若您不同意 **%@** 之隱私權政策，您可以重新挑選另一個不同的伺服器。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Although the Mastodon app does not collect any data, the server you sign up through may have a different policy.\n\nIf you disagree with the policy for **%@**, you can go back and pick a different server."
