        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omlouváme se, nepodařilo se nám najít žádné příspěvky s hashtag <a>#%@</a>. Zkuste prosím <a>#DifferentHashtag</a> nebo zkontrolujte nastavení widgetu."
