    "Scene.Report.StepFinal.YouWontSeeTheirPostsOrReblogsInYourHomeFeedTheyWontKnowTheyVeBeenMuted": {
      "comment": null,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You won’t see their posts or boosts in your home feed. They won’t know they’ve been muted."
          }
        },
        "ar": {
          "stringUnit": {
