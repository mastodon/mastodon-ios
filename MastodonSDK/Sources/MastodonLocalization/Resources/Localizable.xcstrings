        },
        "be": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Праверце, ці правільны ваш адрас электроннай пошты, а таксама папку са спамам, калі вы гэтага яшчэ не зрабілі."
          }
        },
        "my": {
          "stringUnit": {
