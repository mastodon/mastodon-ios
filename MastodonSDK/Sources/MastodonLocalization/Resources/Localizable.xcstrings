    "Scene.ConfirmEmail.OpenEmailApp.Description" : {
      "extractionState" : "migrated",
      "localizations" : {
        "an" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T'acabamos de ninviar un correu electronico. Revisa la tuya carpeta de correu no deseyau si no l'has feito ya."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقد أرسلنا لك بريدًا إلكترونيًا للتو. تحقق من مجلد البريد غير الهام الخاص بك إذا لم تكن قد فعلت ذلك."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы толькі што даслалі вам электронны ліст. Праверце папку са спамам, калі не знайшлі яго."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acabem d'enviar-te un correu electrònic. Revisa la carpeta de correu brossa si encara no ho has fet."
          }
        },
        "ckb-IR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ئیمێڵێکمان بۆ ناردیت. هەموو بوخچەکانت ببینە."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Právě jsme vám poslali e-mail. Zkontrolujte složku nevyžádané zprávy, pokud ji máte."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rydym newydd anfon e-bost atoch chi. Gwiriwch eich ffolder 'junk' os nad ydych wedi ei gwneud."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi har lige sendt dig en e-mail. Tjek din spam-mappe, hvis du ikke har gjort det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben dir gerade eine E-Mail geschickt. Überprüfe deinen Spam-Ordner, falls du es noch nicht getan hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόλις σου στείλαμε ένα email. Έλεγξε το φάκελο ανεπιθύμητης αλληλογραφίας αν δεν το έχεις κάνει ήδη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We just sent you an email. Check your junk folder if you haven’t."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "We just sent you an email. Check your junk folder if you haven’t."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te acabamos de enviar un correo electrónico. Revisa tu carpeta de correo no deseado si no lo has hecho ya."
          }
        },
        "es-AR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te acabamos de enviar un correo electrónico. Revisá tu carpeta de correo basura / correo no deseado / spam, si todavía no lo hiciste."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me just saatsime sulle e-kirja. Kui sa pole seda saanud, siis vaata igaks juhuks ka spämmikausta."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eposta bat bidali dizugu. Egiaztatu zure zaborraren karpeta."
