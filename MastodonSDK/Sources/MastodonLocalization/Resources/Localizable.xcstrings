    "Common.Controls.Timeline.Header.BlockingWarning": {
      "comment": null,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can’t view this user's profile\nuntil you unblock them.\nYour profile looks like this to them."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يُمكِنُكَ الاِطلاع على الملف التَعريفي لهذا المُستخدِم\nحتَّى تَرفعَ الحَظر عنه.\nملفُّكَ التَعريفي يَظهَرُ بِمثل هذِهِ الحالة بالنسبةِ لَهُ أيضًا."
          }
        },
        "an": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No puetz veyer lo perfil d'este usuario\n dica que lo desbloqueyes.\nLo tuyo perfil se veye asinas pa ell."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "needs_review",
            "value": "You can’t view this user's profile\nuntil you unblock them.\nYour profile looks like this to them."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ezin duzu erabiltzaile honen profila ikusi\ndesblokeatzen duzun arte.\nZure profilak itxura hau du berarentzat."
          }
        },
        "be": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вы не можаце праглядаць профіль гэтага карыстальніка, \nпакуль не разблакіруеце яго.\nВось так для іх выглядае ваш профіль."
          }
        },
        "my": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ဒီအသုံးပြုသူ၏ ပရိုဖိုင်ကို ဘလော့မဖြုတ်မချင်း ကြည့်၍မရပါ၊ သင်၏ ပရိုဖိုင်သည် ထိုသူတို့ထံ ဤကဲ့သို့ ပေါ်နေပါမည်။"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No pots veure el perfil d'aquest usuari\nfins que el desbloquis.\nEl teu perfil els sembla així."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "您无法查看这位用户的个人资料\n直到您取消屏蔽。\n您的个人资料对他来说也是这样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "您無法瀏覽該使用者的個人檔案，除非您取消封鎖。\n您的個人檔案看起來像是這樣。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nemůžete zobrazit profil tohoto uživatele, dokud ho neodblokujete.\nVáš profil pro něj vypadá takto."
          }
        },
        "da": {
          "stringUnit": {
