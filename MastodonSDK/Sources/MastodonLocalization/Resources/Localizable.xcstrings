        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn không thể xem trang người này\ncho tới khi bạn bỏ chặn họ.\nHọ sẽ thấy trang của bạn như thế này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您无法查看此用户的个人资料\n直到您解除屏蔽。\n您的个人资料对他来说也是这样的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
