    "Scene.Report.Content1" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل ترغب في إضافة أي منشورات أُخرى إلى البلاغ؟"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ці ёсць іншыя допісы, якія вы хацелі б дадаць да скаргі?"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi ha algun altre tut que vulguis afegir a l'informe?"
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پۆستی تر هەیە بتەوێت سکاڵایان لێ بکەیت؟"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Existují nějaké další příspěvky, které byste chtěli přidat do zprávy?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt es noch weitere Beiträge, die du der Meldung hinzufügen möchtest?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υπάρχουν άλλες αναρτήσεις που θα ήθελες να προσθέσεις στην αναφορά;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Are there any other posts you’d like to add to the report?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Hay alguna otra publicación que te gustaría añadir al reporte?"
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salaketan beste bidalketarik gehitu nahi duzu?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onko julkaisuja, joita haluaisit lisätä ilmiantoon?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Y a-t-il d’autres messages que vous aimeriez ajouter au signalement?"
          }
        },
        "gd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bheil post sam bith eile ann a bu mhiann leat cur ris a’ ghearan?"
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai outras publicacións que desexes engadir á denuncia?"
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are there any other posts you’d like to add to the report?"
          }
        },
        "hy-AM" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are there any other posts you’d like to add to the report?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ci sono altri post che vorresti aggiungere alla segnalazione?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他に通報したい投稿はありますか？"
          }
        },
        "kab" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tebɣiḍ ad ternuḍ tisuffaɣ-nniḍen ɣer uneqqis?"
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şandiyên din hene ku tu dixwazî tevlî ragihandinê bikî?"
          }
        },
        "ku-TR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şandiyên din hene ku tu dixwazî tevlî ragihandinê bikî?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zijn er nog meer berichten die je aan het rapport wilt toevoegen?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Есть ли другие сообщения, которые вы хотите добавить в отчёт?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali so še kakšne druge objave, ki bi jih želeli dodati k prijavi?"
