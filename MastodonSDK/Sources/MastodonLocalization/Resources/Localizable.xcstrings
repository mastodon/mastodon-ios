          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нам вельмі шкада, але адбылася памылка, і мы не змаглі апрацаваць Вашае ахвяраванне.\n\nКалі ласка, паспрабуйце яшчэ праз некалькі хвілін."
          }
        },
        "ca" : {
          "stringUnit" : {
