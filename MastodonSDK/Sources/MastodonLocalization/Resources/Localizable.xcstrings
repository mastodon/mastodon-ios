    "Common.Controls.Timeline.Header.BlockedWarning": {
      "comment": null,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can’t view this user’s profile\nuntil they unblock you."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يُمكِنُكَ عَرض الملف التَعريفي لهذا المُستخدِم\nحتَّى يَرفَعَ الحَظرَ عَنك."
          }
        },
        "an": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No puetz veyer lo perfil d'este usuario\n dica que te desbloqueye."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "needs_review",
            "value": "You can’t view this user’s profile\nuntil they unblock you."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ezin duzu erabiltzaile honen profila ikusi\ndesblokeatzen zaituen arte."
          }
        },
        "be": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вы не можаце праглядаць профіль гэтага карыстальніка, \nпакуль ён не разблакіруе вас."
          }
        },
        "my": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ဤပုဂ္ဂိုလ်မှ သင့်ကို ဘလော့မဖြုတ်မချင်း သူ၏ ပရိုဖိုင်သည် သင် ကြည့်၍မရပါ။"
          }
        },
        "ca": {
          "stringUnit": {
