    "Scene.ServerPicker.NoServerSelectedHint" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سوف نختار خادماً بناءً على لغتك إذا قمت بالمتابعة دون إجراء إختيار."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калі вы не выберыце сервер, то мы выберам яго на аснове вашай мовы."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escollirem un servidor basat en la teva llengua si continues sense res seleccionat.\nElegiremos un servidor basado en su idioma si continúa sin hacer una selección."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We’ll pick a server based on your language if you continue without making a selection."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud budete pokračovat bez výběru, vybereme server založený na Vašem jazyce."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie fortfahren, ohne eine Auswahl zu treffen, wird ein Server auf der Grundlage Ihrer Sprache ausgewählt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα επιλέξουμε έναν διακομιστή με βάση τη γλώσσα σου αν συνεχίσεις χωρίς να κάνεις κάποια επιλογή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "We’ll pick a server based on your language if you continue without making a selection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleccionaremos un servidor basado en tu idioma si continúas sin hacer una selección."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hautaketarik egin gabe jarraituz gero, zure hizkuntzaren arabera aukeratuko dugu zerbitzari bat."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palvelin valitaan kielesi perusteella, jos jatkat ilman valintaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous choisirons un serveur basé sur votre langue si vous continuez sans en choisir un."
          }
        },
        "gd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taghaidh sinn frithealaiche dhut stèidhichte air a’ chànan agad ma leanas tu air adhart gun taghadh."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se non elixes ti, escolleremos un servidor en función do teu idioma."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We’ll pick a server based on your language if you continue without making a selection."
          }
        },
        "hy-AM" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We’ll pick a server based on your language if you continue without making a selection."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sceglieremo un server in base alla tua lingua se continui senza effettuare una selezione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択せずに次へ進むと、利用中の言語に基づいてサーバーを自動選択します。"
          }
        },
        "kab" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We’ll pick a server based on your language if you continue without making a selection."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ku tu yê bêyî hilbijartinê bidomînî em ê rajekarekî gorî zimanê te hilbijêrin."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je doorgaat zonder een selectie te maken, kiezen we een server gebaseerd op jouw taal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We’ll pick a server based on your language if you continue without making a selection."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbrali bomo strežnik na osnovi vašega jezika, če nadaljujete brez izbire."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi kommer att välja en server baserat på ditt språk om du fortsätter utan att göra ett val."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เราจะเลือกเซิร์ฟเวอร์โดยอิงตามภาษาของคุณหากคุณดำเนินการต่อโดยไม่ได้ทำการเลือก"
