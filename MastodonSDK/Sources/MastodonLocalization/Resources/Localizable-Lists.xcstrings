    "Scene.Lists.hideMembersExplainer" : {
      "extractionState" : "manual",
      "localizations" : {
        "an" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If someone is on this list, hide them in your Home feed to avoid seeing their posts twice."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If someone is on this list, hide them in your Home feed to avoid seeing their posts twice."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калі ў гэтым спісе нехта ёсць, схавайце яго ў сваёй Галоўнай стужцы, каб не бачыць яго допісы двойчы."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If someone is on this list, hide them in your Home feed to avoid seeing their posts twice."
          }
        },
        "ckb-IR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If someone is on this list, hide them in your Home feed to avoid seeing their posts twice."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If someone is on this list, hide them in your Home feed to avoid seeing their posts twice."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If someone is on this list, hide them in your Home feed to avoid seeing their posts twice."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis nogen står på denne liste, kan du skjule dem i dit hjem-feed, så du ikke ser deres opslag to gange."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile, die sich auf dieser Liste befinden, werden nicht im Feed deiner Startseite angezeigt, damit deren Beiträge nicht doppelt erscheinen."
          }
        },
        "el" : {
