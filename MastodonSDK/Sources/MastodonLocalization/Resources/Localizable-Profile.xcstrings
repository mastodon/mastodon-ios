    "Scene.EditProfile.FeaturedHashtags.addConfirmedText" : {
      "comment" : "translation must include the # hashtag symbol",
      "extractionState" : "manual",
      "localizations" : {
        "an" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "#%1$(tagName)@ is now featured on your profile page. Do you want to add another?"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "#%1$(tagName)@ is now featured on your profile page. Do you want to add another?"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "#%1$(tagName)@ цяпер у Вашай укладцы \"Выбранае\" на старонцы профілю. Хочаце дадаць яшчэ адзін?"
          }
        },
