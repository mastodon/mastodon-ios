          }
        },
        "es-AR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agregar el código a tu encabezado permite que el elemento <a> permanezca invisible. El atributo rel=\\\"me\\\" previene la suplantación en sitios web con contenido generado por el usuario, por lo que es importante conservarlo."
          }
        },
        "et" : {
          "stringUnit" : {
