    "ConfirmationDialog.LogOut.AllAccounts.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "an" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "All your local settings and data will be erased. To log in again, you will have to handle each account separately."
          }
        },
        "ar" : {
